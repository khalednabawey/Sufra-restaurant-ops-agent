# Copy to .env. Never commit .env.

# Local database (docker compose). Host port 5433 so it doesn't clash with a local PostgreSQL on 5432.
POSTGRES_USER=sufra
POSTGRES_PASSWORD=sufra
POSTGRES_DB=sufra
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sufra:sufra@localhost:5433/sufra

# Models (week 2). Pick IDs from the current Groq and OpenRouter model lists.
LLM_PRIMARY_PROVIDER=groq
LLM_PRIMARY_MODEL=
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=
LLM_JUDGE_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Tracing (week 3)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Signs the caller-scope tokens the MCP tools trust. Set a long random value outside local dev.
SCOPE_SIGNING_KEY=dev-only-signing-key-change-me-0123456789

# Local embedding model for the knowledge base (1024 dimensions, ~2.3 GB download on first use)
EMBEDDING_MODEL=BAAI/bge-m3
