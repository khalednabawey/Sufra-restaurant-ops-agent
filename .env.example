# Copy to .env. Never commit .env.

# Local database (docker compose). Host port 5433 so it doesn't clash with a local PostgreSQL on 5432.
POSTGRES_USER=sufra
POSTGRES_PASSWORD=sufra
POSTGRES_DB=sufra
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sufra:sufra@localhost:5433/sufra

# Models (week 2). Pick IDs from the current Groq and OpenRouter model lists.
LLM_PRIMARY_PROVIDER=groq
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# Groq retries; 0 = on a rate limit, answer from OpenRouter instead of waiting 10-30 s
LLM_PRIMARY_MAX_RETRIES=0

# Tracing (week 3)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Signs the caller-scope tokens the MCP tools trust. Set a long random value outside local dev.
SCOPE_SIGNING_KEY=dev-only-signing-key-change-me-0123456789

# Local embedding model for the knowledge base (1024 dimensions, ~2.3 GB download on first use)
EMBEDDING_MODEL=BAAI/bge-m3
# Optional: model commit to load. Defaults to the pinned safetensors revision in mcp_server/embeddings.py.
EMBEDDING_REVISION=
